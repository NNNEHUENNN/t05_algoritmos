{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Archivo actual",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: pytest (todos)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests",
                "-v",
                "--no-header"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: pytest (archivo actual)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Script con argumentos",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": [
                "--ejemplo",
                "valor"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
